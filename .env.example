# ==============================================================================
# AI CUSTOMER SERVICE & SALES EMPLOYEE CONFIGURATION (إعدادات موظف الذكاء الاصطناعي)
# ==============================================================================
# 1. Google Gemini API Key (المفتاح الأساسي الموصى به لموظف خدمة العملاء الذكي):
#    - ضع مفتاح Google Gemini API الخاص بك هنا.
#    - السيرفر مربوط تلقائياً بموديل gemini-3.8-flash فائق السرعة والمحادثة البشرية.
#    - يمكنك أيضاً إضافته في إعدادات المنصة من قائمة Settings > Secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# 2. DeepSeek API Key (مفتاح بديل اختياري إذا أردت استخدام سيرفر DeepSeek):
DEEPSEEK_API_KEY="YOUR_DEEPSEEK_API_KEY_HERE"

# 3. APP_URL: The URL where this applet is hosted (auto-injected in production).
APP_URL="MY_APP_URL"
